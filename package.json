{
  "name": "whitepay",
  "private": true,
  "version": "0.1.0",
  "description": "UPI-style USDT payments on Whitechain: pay a name, gasless, with ENS, Arkiv and World ID",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w @whitepay/web",
    "demo:lifecycle": "tsx --env-file=.env scripts/lifecycle-demo.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
